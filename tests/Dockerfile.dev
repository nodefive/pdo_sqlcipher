# =============================================================================
#  pdo_sqlcipher — multi-PHP dev image with Apache
#
#  Managed via tests/dev.sh
# =============================================================================

ARG CACHEBUST=1

FROM ubuntu:24.04

ARG CACHEBUST

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Add ondrej/php PPA — manual curl+gpg, avoids software-properties-common issues
RUN echo "Cache bust: ${CACHEBUST}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl gpg ca-certificates && \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x14AA40EC0831756756D7F66C4F4EA0AAE5267A6C" \
        | gpg --dearmor -o /etc/apt/trusted.gpg.d/ondrej-php.gpg && \
    echo "deb https://ppa.launchpadcontent.net/ondrej/php/ubuntu noble main" \
        > /etc/apt/sources.list.d/ondrej-php.list && \
    apt-get update

# Install Apache and all PHP-FPM versions
RUN apt-get install -y --no-install-recommends \
        apache2 \
        php7.4-fpm  php7.4-common \
        php8.0-fpm  php8.0-common \
        php8.1-fpm  php8.1-common \
        php8.2-fpm  php8.2-common \
        php8.3-fpm  php8.3-common \
        php8.4-fpm  php8.4-common \
        php8.5-fpm  php8.5-common && \
    rm -rf /var/lib/apt/lists/*

# Enable required Apache modules
RUN a2enmod proxy proxy_fcgi rewrite headers

# ── pdo_sqlcipher extension ────────────────────────────────────────────────
COPY release/php7.4/pdo_sqlcipher.so /usr/lib/php/20190902/pdo_sqlcipher.so
COPY release/php8.0/pdo_sqlcipher.so /usr/lib/php/20200930/pdo_sqlcipher.so
COPY release/php8.1/pdo_sqlcipher.so /usr/lib/php/20210902/pdo_sqlcipher.so
COPY release/php8.2/pdo_sqlcipher.so /usr/lib/php/20220829/pdo_sqlcipher.so
COPY release/php8.3/pdo_sqlcipher.so /usr/lib/php/20230831/pdo_sqlcipher.so
COPY release/php8.4/pdo_sqlcipher.so /usr/lib/php/20240924/pdo_sqlcipher.so
COPY release/php8.5/pdo_sqlcipher.so /usr/lib/php/20250925/pdo_sqlcipher.so

RUN chmod 644 \
        /usr/lib/php/20190902/pdo_sqlcipher.so \
        /usr/lib/php/20200930/pdo_sqlcipher.so \
        /usr/lib/php/20210902/pdo_sqlcipher.so \
        /usr/lib/php/20220829/pdo_sqlcipher.so \
        /usr/lib/php/20230831/pdo_sqlcipher.so \
        /usr/lib/php/20240924/pdo_sqlcipher.so \
        /usr/lib/php/20250925/pdo_sqlcipher.so

# Write INI files so PHP auto-loads the extension (FPM + CLI)
RUN for ver in 7.4 8.0 8.1 8.2 8.3 8.4 8.5; do \
        for sapi in fpm cli; do \
            dir="/etc/php/${ver}/${sapi}/conf.d"; \
            [ -d "${dir}" ] && printf 'extension=pdo_sqlcipher.so\n' \
                > "${dir}/99-pdo_sqlcipher.ini"; \
        done; \
    done

# ── Apache virtualhost ─────────────────────────────────────────────────────
RUN printf '<VirtualHost *:80>\n\
    ServerName localhost\n\
    DocumentRoot /var/www/html\n\
\n\
    <Directory /var/www/html>\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
\n\
    <FilesMatch "\\.php$">\n\
        SetHandler "proxy:unix:/run/php/active-php-fpm.sock|fcgi://localhost"\n\
    </FilesMatch>\n\
\n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>\n' > /etc/apache2/sites-available/pdo-dev.conf && \
    a2dissite 000-default && \
    a2ensite pdo-dev

RUN printf '\nServerName localhost\n' >> /etc/apache2/apache2.conf

# ── Container entrypoint (start.sh) ───────────────────────────────────────
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    'mkdir -p /run/php' \
    'chown -R www-data:www-data /var/www/html' \
    'chmod -R 755 /var/www/html' \
    'echo "[start] Starting PHP-FPM for all versions..."' \
    'for ver in 7.4 8.0 8.1 8.2 8.3 8.4 8.5; do' \
    '    bin="/usr/sbin/php-fpm${ver}"' \
    '    if [ -x "${bin}" ]; then' \
    '        "${bin}" --daemonize --fpm-config "/etc/php/${ver}/fpm/php-fpm.conf" --pid "/run/php/php${ver}-fpm.pid"' \
    '        echo "[start]   php${ver}-fpm started"' \
    '    else' \
    '        echo "[start]   WARNING: ${bin} not found, skipping PHP ${ver}"' \
    '    fi' \
    'done' \
    'echo "[start] Waiting for PHP 7.4 FPM socket..."' \
    'for i in $(seq 1 40); do' \
    '    [ -S /run/php/php7.4-fpm.sock ] && break' \
    '    sleep 0.25' \
    'done' \
    'if [ ! -S /run/php/php7.4-fpm.sock ]; then' \
    '    echo "[start] ERROR: PHP 7.4 FPM socket did not appear" >&2' \
    '    exit 1' \
    'fi' \
    'ln -sf /run/php/php7.4-fpm.sock /run/php/active-php-fpm.sock' \
    'echo "[start] Active PHP version: 7.4"' \
    'echo "[start] Starting Apache on port 80..."' \
    'exec apache2ctl -D FOREGROUND' \
    > /start.sh && chmod +x /start.sh

# ── PHP version switcher (switch-php) ─────────────────────────────────────
RUN printf '%s\n' \
    '#!/bin/bash' \
    'VERSIONS=(7.4 8.0 8.1 8.2 8.3 8.4 8.5)' \
    'VER="${1}"' \
    'if [ -z "${VER}" ]; then' \
    '    echo "Usage: switch-php <version>"' \
    '    echo "Available: ${VERSIONS[*]}"' \
    '    if [ -L /run/php/active-php-fpm.sock ]; then' \
    '        echo "Current: $(readlink /run/php/active-php-fpm.sock)"' \
    '    fi' \
    '    exit 1' \
    'fi' \
    'valid=0' \
    'for v in "${VERSIONS[@]}"; do' \
    '    [ "${v}" = "${VER}" ] && valid=1 && break' \
    'done' \
    'if [ "${valid}" -eq 0 ]; then' \
    '    echo "Error: unknown PHP version ${VER}. Available: ${VERSIONS[*]}" >&2' \
    '    exit 1' \
    'fi' \
    'SOCK="/run/php/php${VER}-fpm.sock"' \
    'if [ ! -S "${SOCK}" ]; then' \
    '    echo "Error: FPM socket not found: ${SOCK}" >&2' \
    '    exit 1' \
    'fi' \
    'ln -sf "${SOCK}" /run/php/active-php-fpm.sock' \
    'apachectl graceful' \
    'echo "Active PHP version: ${VER}"' \
    > /usr/local/bin/switch-php && chmod +x /usr/local/bin/switch-php

EXPOSE 80

CMD ["/start.sh"]
